# =============================================================================
# BossSchool — environment template.
#
# Copy this file to .env, then fill in real values. In production:
#   APP_ENV=production
#   APP_DEBUG=false
#   APP_URL=https://your-domain.tld
#   DB_CONNECTION=mysql  (or whatever your host provides)
# =============================================================================

APP_NAME="BossSchool"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_TIMEZONE=Africa/Accra
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# -----------------------------------------------------------------------------
# Platform safety
# Keep PLATFORM_ALLOW_RESET_ALL=false in any environment that holds real
# school data. Enabling it exposes the "Reset all schools" web action.
# -----------------------------------------------------------------------------
PLATFORM_ALLOW_RESET_ALL=false
DEMO_ALLOWED_IN_PROD=false

# 2FA enforcement (privileged roles must enroll on first login)
AUTH_ENFORCE_2FA=true

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Database — MySQL/MariaDB on cPanel typically:
#   DB_CONNECTION=mysql
#   DB_HOST=127.0.0.1
#   DB_PORT=3306
#   DB_DATABASE=cpaneluser_bossschool
#   DB_USERNAME=cpaneluser_dbuser
#   DB_PASSWORD=...
# Local dev defaults to sqlite for zero-config.
# -----------------------------------------------------------------------------
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=bossschool
# DB_USERNAME=
# DB_PASSWORD=

# -----------------------------------------------------------------------------
# Session / cache / queue
# Use `database` for session/queue/cache in production; `array` is for tests.
# -----------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# Mail — for password resets, support replies, end-of-term notifications etc.
# On cPanel use SMTP via your Email Account:
#   MAIL_MAILER=smtp
#   MAIL_HOST=mail.your-domain.tld
#   MAIL_PORT=465
#   MAIL_USERNAME=no-reply@your-domain.tld
#   MAIL_PASSWORD=...
#   MAIL_SCHEME=ssl
# -----------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# AWS S3 (only if you switch FILESYSTEM_DISK=s3 for backups)
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# -----------------------------------------------------------------------------
# Payments — Paystack
# The platform keys can ALSO be set from the SuperAdmin UI at
# /platform/payments/settings (stored encrypted in platform_settings).
# The env values act as a fallback / bootstrap default.
# -----------------------------------------------------------------------------
PAYMENTS_PAYSTACK_ENABLED=false
PAYMENTS_PAYSTACK_SECRET=

# Other supported (optional) providers:
PAYMENTS_HUBTEL_ENABLED=false
PAYMENTS_HUBTEL_SECRET=
PAYMENTS_HUBTEL_CLIENT_ID=

PAYMENTS_FLUTTERWAVE_ENABLED=false
PAYMENTS_FLUTTERWAVE_SECRET=

PAYMENTS_EXPRESSPAY_ENABLED=false
PAYMENTS_EXPRESSPAY_SECRET=
PAYMENTS_EXPRESSPAY_MERCHANT_ID=

# -----------------------------------------------------------------------------
# SMS — outbound messaging providers.
# `SMS_BILL_VIA_CREDITS=true` makes every SMS debit the tenant's purchased
# credits balance (see /billing/sms-credits).
# -----------------------------------------------------------------------------
SMS_DEFAULT_PROVIDER=log
SMS_SENDER_ID=BOSSSCHOOL
SMS_SANDBOX=false
SMS_BILL_VIA_CREDITS=true

# Hubtel
SMS_HUBTEL_ENABLED=false
SMS_HUBTEL_CLIENT_ID=
SMS_HUBTEL_CLIENT_SECRET=
SMS_HUBTEL_SENDER_ID=

# mNotify
SMS_MNOTIFY_ENABLED=false
SMS_MNOTIFY_API_KEY=
SMS_MNOTIFY_SENDER_ID=

# Arkesel
SMS_ARKESEL_ENABLED=false
SMS_ARKESEL_API_KEY=
SMS_ARKESEL_SENDER_ID=

# Twilio
SMS_TWILIO_ENABLED=false
SMS_TWILIO_ACCOUNT_SID=
SMS_TWILIO_AUTH_TOKEN=
SMS_TWILIO_FROM=

# -----------------------------------------------------------------------------
# Backups
# -----------------------------------------------------------------------------
BACKUP_DISK=local
BACKUP_PATH=tenant-backups
BACKUP_REQUIRED_FOR_RESET=true
BACKUP_MAX_AGE_FOR_RESET=86400

# -----------------------------------------------------------------------------
# Error tracking (optional)
# -----------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

BUGSNAG_API_KEY=

# -----------------------------------------------------------------------------
# Vite / front-end build (only needed if you switch off the Tailwind CDN and
# rebuild assets with `npm run build`).
# -----------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
